    "heft": "node dist/cli.js"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0"
  }
}
