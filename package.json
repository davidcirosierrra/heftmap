{
  "name": "heft",
  "displayName": "Heft",
  "description": "Qué pesa en este repo y se está usando: tamaños, treemap, huérfanos y hotspots.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
