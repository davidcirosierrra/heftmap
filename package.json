{
  "name": "heft",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "version": "0.1.0",
  "publisher": "davidcirosierrra",
  "author": {
    "name": "David-Ciro Sierra Garcia"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcirosierrra/Heft"
  },
  "homepage": "https://github.com/davidcirosierrra/Heft#readme",
  "bugs": {
    "url": "https://github.com/davidcirosierrra/Heft/issues"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "treemap",
    "file size",
    "disk usage",
    "unused files",
    "unused assets",
    "orphan files",
    "hotspots",
    "churn",
    "git history",
    "monorepo",
    "bundle size",
    "assets",
    "tamaño de archivos",
    "huérfanos",
    "euskara"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "heft.publicDir",
        "heft.git.since",
        "heft.usage.ignore",
        "heft.usage.entryPoints"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "heft",
          "title": "%container.title%",
          "icon": "media/heft.svg"
        }
      ]
    },
    "views": {
      "heft": [
        {
          "id": "heft.folders",
          "name": "%view.folders%",
          "icon": "media/heft.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "heft.folders",
        "contents": "%view.welcome%",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "heft.openPanel",
        "title": "%command.openPanel%",
        "category": "Heft",
        "icon": "$(table)"
      },
      {
        "command": "heft.refresh",
        "title": "%command.refresh%",
        "category": "Heft",
        "icon": "$(refresh)"
      },
      {
        "command": "heft.pickScope",
        "title": "%command.pickScope%",
        "category": "Heft",
        "icon": "$(filter)"
      },
      {
        "command": "heft.clearScope",
        "title": "%command.clearScope%",
        "category": "Heft",
        "icon": "$(clear-all)"
      },
      {
        "command": "heft.addToScope",
        "title": "%command.addToScope%",
        "category": "Heft"
      },
      {
        "command": "heft.limitScope",
        "title": "%command.limitScope%",
        "category": "Heft"
      },
      {
        "command": "heft.revealInExplorer",
        "title": "%command.revealInExplorer%",
        "category": "Heft"
      },
      {
        "command": "heft.showLog",
        "title": "%command.showLog%",
        "category": "Heft"
      },
      {
        "command": "heft.copyReport",
        "title": "%command.copyReport%",
        "category": "Heft"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "heft.openPanel",
          "when": "view == heft.folders",
          "group": "navigation@0"
        },
        {
          "command": "heft.pickScope",
          "when": "view == heft.folders",
          "group": "navigation@1"
        },
        {
          "command": "heft.clearScope",
          "when": "view == heft.folders",
          "group": "navigation@2"
        },
        {
          "command": "heft.refresh",
          "when": "view == heft.folders",
          "group": "navigation@3"
        },
        {
          "command": "heft.showLog",
          "when": "view == heft.folders"
        },
        {
          "command": "heft.copyReport",
          "when": "view == heft.folders"
        }
      ],
      "view/item/context": [
        {
          "command": "heft.limitScope",
          "when": "view == heft.folders && viewItem == heftDir",
          "group": "heft@1"
        },
        {
          "command": "heft.revealInExplorer",
          "when": "view == heft.folders && viewItem =~ /^heft(Dir|File)$/",
          "group": "heft@2"
        }
      ],
      "explorer/context": [
        {
          "command": "heft.addToScope",
          "when": "explorerResourceIsFolder",
          "group": "heft@1"
        },
        {
          "command": "heft.limitScope",
          "when": "explorerResourceIsFolder",
          "group": "heft@2"
        }
      ],
      "commandPalette": [
        {
          "command": "heft.addToScope",
          "when": "false"
        },
        {
          "command": "heft.limitScope",
          "when": "false"
        },
        {
          "command": "heft.revealInExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "heft.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es",
            "eu"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Español",
            "Euskara"
          ],
          "description": "%config.language%"
        },
        "heft.publicDir": {
          "type": "string",
          "default": "public",
          "description": "%config.publicDir%"
        },
        "heft.git.since": {
          "type": "string",
          "default": "",
          "description": "%config.git.since%"
        },
        "heft.usage.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.usage.ignore%"
        },
        "heft.usage.entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.usage.entryPoints%"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:ext",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --external:typescript --outfile=dist/cli.js",
    "build:ext": "npm run build:host && npm run build:worker && npm run build:webview",
    "build:host": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --sourcemap --outfile=dist/extension.cjs",
    "build:worker": "esbuild src/extension/worker.ts --bundle --platform=node --format=cjs --target=node20 --minify --sourcemap --outfile=dist/worker.cjs",
    "build:webview": "esbuild src/webview/main.tsx --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview.js",
    "watch:ext": "npm run build:worker && npm run build:webview && npm run build:host -- --watch",
    "package": "npm run build:ext && vsce package --no-dependencies --out heft.vsix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "heft": "node dist/cli.js"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.0"
  }
}
